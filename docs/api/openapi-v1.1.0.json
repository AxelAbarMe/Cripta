                      "armadura": "#/components/schemas/Armor",
                      "pocion": "#/components/schemas/Potion",
                      "antidoto": "#/components/schemas/Antidote",
                      "llave": "#/components/schemas/Key",
                      "antorcha": "#/components/schemas/Torch",
                      "pergamino_retroceso": "#/components/schemas/RewindScroll",
                      "trampa": "#/components/schemas/Trap"
                    }
                  },
                  "title": "Response Get Catalog Entry V1 Catalogo  Catalog Id  Get"
                }
              }
            }
          },
